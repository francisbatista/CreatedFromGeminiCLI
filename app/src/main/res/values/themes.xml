<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.CreatedFromGeminiCLI" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="android:windowBackground">@color/primary_dark</item>
    </style>

    <style name="CalcButton" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">80dp</item>
        <item name="android:layout_margin">8dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Rounded</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="CalcButton.Number">
        <item name="backgroundTint">@color/number_bg</item>
        <item name="android:textColor">@color/text_white</item>
    </style>

    <style name="CalcButton.Operator">
        <item name="backgroundTint">@color/operator_color</item>
        <item name="android:textColor">@color/text_white</item>
    </style>

    <style name="CalcButton.Control">
        <item name="backgroundTint">@color/control_bg</item>
        <item name="android:textColor">@color/text_white</item>
    </style>

    <style name="ShapeAppearance.Rounded" parent="">
        <item name="cornerSize">24dp</item>
    </style>
</resources>
